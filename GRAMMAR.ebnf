(* Property Graph Markdown 0.3.0 class-expression grammar. *)

ClassExpression ::=
    ":" ClassName (Whitespace PropertyMap)? ;

ClassName ::=
    Identifier ;

Identifier ::=
    Letter (Letter | Digit | "_")* ;

PropertyMap ::=
    YAMLFlowMapping ;

(* A PGM processor first parses an ordinary CommonMark inline link. *)
(* This grammar applies only to the parsed link text. *)
(* The parsed CommonMark destination selects the semantic role: *)
(* empty means a node annotation; non-empty means a relationship. *)
(* PropertyMap delegates to YAML 1.2 Flow Mapping. *)
(* This grammar intentionally does not duplicate CommonMark link grammar. *)
