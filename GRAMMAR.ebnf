(* Property Graph Markdown 0.2.1 semantic-link grammar. *)

SemanticLink ::=
    NodeLabel
  | RelationshipDescriptor ;

NodeLabel ::=
    ":LABEL" ;

RelationshipDescriptor ::=
    ":" RelationshipType PropertyMap? ;

RelationshipType ::=
    Identifier ;

Identifier ::=
    Letter (Letter | Digit | "_")* ;

PropertyMap ::=
    YAMLFlowMapping ;

(* PropertyMap delegates to YAML 1.2 Flow Mapping. *)
(* LABEL is a reserved keyword with Node label semantics. *)
(* LABEL must not be followed by PropertyMap. *)
(* This grammar intentionally defines no Markdown block syntax. *)
