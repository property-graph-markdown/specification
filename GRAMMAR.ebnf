(* Property Graph Markdown 0.2.0 semantic-link-label grammar. *)

SemanticLinkLabel ::=
    ":" AnnotationType PropertyMap? ;

AnnotationType ::=
    Identifier ;

Identifier ::=
    Letter (Letter | Digit | "_")* ;

PropertyMap ::=
    YAMLFlowMapping ;

(* PropertyMap delegates to YAML 1.2 Flow Mapping. *)
(* LABEL is a reserved AnnotationType with label semantics. *)
(* LABEL must not be followed by PropertyMap. *)
(* This grammar intentionally defines no Markdown block syntax. *)
